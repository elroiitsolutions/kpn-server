# ==============================================================================
# KPN PROMOTERS - BACKEND SERVER ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

PORT=5000
NODE_ENV=development

# MySQL / MariaDB (phpMyAdmin) Configuration
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=kpn_promoters

# Legacy MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/kpn_promoters

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:3000

# Cloudinary Configuration (Optional - fallback to local uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL_TO=kpnsalesteam@gmail.com

# Integrations
WHATSAPP_API_KEY=
SMS_GATEWAY_URL=
